{
  "name": "hexfence",
  "private": true,
  "license": "MIT",
  "description": "HexFence: a Safe Guard that refuses lookalike payments (deny by resemblance), with open address-poisoning evidence on Arkiv.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "test:contracts": "cd contracts && npx hardhat test",
    "merged:check": "pnpm --filter @hexfence/integration check",
    "merged:test": "pnpm --filter @hexfence/integration test",
    "pramaan:install": "pnpm --dir pramaan install --frozen-lockfile",
    "pramaan:test": "pnpm --dir pramaan test",
    "pramaan:build:extension": "pnpm --dir pramaan build:extension",
    "pramaan:demo": "pnpm --dir pramaan demo:up --fixtures",
    "test:all": "pnpm test && pnpm merged:test && pnpm pramaan:test"
  }
}
