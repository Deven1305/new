# Pramaan environment template. Copy to `.env` (gitignored) and fill in what you need.
# The CLI (`pnpm pramaan …`, `pnpm run doctor`) loads <repo>/.env automatically; variables already set in your shell win.
# NEVER put a mainnet key or a key holding real funds here. Use fresh TESTNET-ONLY accounts. Never commit `.env`.
# Check readiness at any time with:  pnpm run doctor --network sepolia --parent <label>
# (plain `pnpm doctor` is pnpm's own built-in command; use `pnpm run doctor` or `pnpm pramaan doctor`).

# ── Sepolia RPC (two DIFFERENT providers; security reads must agree) ─────────────────────────────────────────────
# Free keys: Alchemy, Infura, QuickNode… Public fallbacks used by the doctor when unset:
#   https://sepolia.gateway.tenderly.co  https://rpc.sepolia.ethpandaops.io  https://sepolia.rpc.thirdweb.com
#   https://ethereum-sepolia-rpc.publicnode.com   (publicnode does not serve anvil forks well)
SEPOLIA_RPC_URL_A=
SEPOLIA_RPC_URL_B=
# Generic RPC for CLI commands that take --rpc (falls back to SEPOLIA_RPC_URL_A).
RPC_URL=
# Local anvil fork used by `--network local` (default http://127.0.0.1:8545).
LOCAL_RPC_URL=
# Fork source for the release package's fork tests (default https://sepolia.gateway.tenderly.co).
PRAMAAN_FORK_RPC=

# ── Release identity keys (Sepolia testnet only; three DIFFERENT accounts) ──────────────────────────────────────
# Owner: cold key. Registers <parent>.eth, owns the UserRegistry, every resolver and subname. Needs ≈0.12 ETH budget.
OWNER_PRIVATE_KEY=
# Proposer: release CI key. Can ONLY queue pointers in the PramaanTimelocks (no ENS role at all).
PROPOSER_PRIVATE_KEY=
# Guardian: cancels queued pointers and writes `pramaan.revoked` (ROLE_SET_TEXT on that key only).
GUARDIAN_PRIVATE_KEY=
# Optional executor for `pramaan ens execute` (anyone may execute; defaults to the proposer key).
EXECUTOR_PRIVATE_KEY=
# Parent label for `pnpm pramaan deploy identities` / the doctor (e.g. pramaan-yourteam → pramaan-yourteam.eth).
PRAMAAN_PARENT_LABEL=
# Release signer record for every app (p256-spki:…); default: derived from .pramaan/release-key.pem (`pramaan keygen`).
PRAMAAN_SIGNER_RECORD=
# Timelock delay in seconds (60 … 2592000). Default 120.
TIMELOCK_DELAY_SECONDS=120

# ── ENSv2 address overrides (only after a Sepolia ENS reset; defaults in config/ensv2.sepolia.json) ─────────────
ENSV2_UNIVERSAL_RESOLVER=
ENSV2_ETH_REGISTRAR=
ENSV2_ETH_REGISTRY=
ENSV2_VERIFIABLE_FACTORY=
ENSV2_PERMISSIONED_RESOLVER_IMPL=
ENSV2_USER_REGISTRY_IMPL=
ENSV2_ROOT_REGISTRY=
ENSV2_LABEL_STORE=
ENSV2_MOCK_USDC=

# ── IPFS (availability only; the manifest is trusted by its sha256 in ENS) ──────────────────────────────────────
# Either a Pinata JWT with files:write (secret) or a Kubo RPC API URL.
PINATA_JWT=
IPFS_API_URL=
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# ── Alerts / integrations (all optional) ─────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org
# Fine-grained, read-only GitHub token (raises API rate limits). Secret.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# HMAC secret for the GitHub webhook endpoint. Secret.
GITHUB_WEBHOOK_SECRET=
# Shared secret the CRE workflow uses to post alerts to the server. Secret.
CRE_INGEST_SECRET=
# Chainlink CRE CLI: `cre login`, or an API key here. Secret.
CRE_API_KEY=
# Claude for optional AI-assisted PROVE (`pramaan prove --ai`). Secret.
ANTHROPIC_API_KEY=
PRAMAAN_AI_MODEL=

# ── Server (apps/server) ─────────────────────────────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:8787
# Dashboard origins allowed to call the API with credentials (comma separated).
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SIWE: host[:port] values a sign-in message may name.
SIWE_DOMAINS=localhost:5173,127.0.0.1:5173
# postgres://… in production (secret); unset = embedded PGlite in DATA_DIR.
DATABASE_URL=
DATA_DIR=.pramaan/server
# Required in production on first start: wallet that becomes the first admin (sign in with SIWE).
# ADMIN_ADDRESS=0x...
EMBEDDED_WORKER=1
TRUST_PROXY=0
SESSION_TTL_HOURS=168
COOKIE_SECURE=0
MAX_UPLOAD_MB=50
MAX_ARCHIVE_ENTRIES=20000
MAX_ARCHIVE_EXPANDED_MB=300
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_INGEST_MAX=120
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# RPCs the server uses for verification (comma separated chainId=url,url entries, see apps/server/src/config.ts).
VERIFY_RPC_URLS=
# Allow server-side fetches to private/loopback addresses (defaults to on outside production).
ALLOW_PRIVATE_NETWORK=
MONITOR_INTERVAL_MS=15000
MONITOR_CONFIRMATIONS=1
MONITOR_MAX_RANGE=2000
MONITOR_MAX_CHUNKS=5
MONITOR_LOOKBACK_BLOCKS=5000
WORKER_POLL_MS=1500
WORKER_HEARTBEAT_MS=2000
SSE_POLL_MS=1000
SSE_HEARTBEAT_MS=15000
DEMO_AUTOIMPORT=1
# Overrides the demo state file (default .pramaan/demo/state.json).
DEMO_STATE_PATH=
PRAMAAN_DEMO_STATE=
LOG_LEVEL=info
NODE_ENV=development

# ── Tooling ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Analysis sandbox image tag and allowed git hosts for `pramaan prove`.
PRAMAAN_SANDBOX_IMAGE=
PRAMAAN_GIT_HOSTS=
# Set by the extension E2E runner.
PRAMAAN_E2E=
