{
  "name": "@pramaan/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pramaan developer backend: projects, sandboxed analysis jobs, findings, releases, chain monitoring and alerts. Not part of the end-user trust path.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker-main.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@pramaan/decoder": "workspace:*",
    "@pramaan/engine": "workspace:*",
    "@pramaan/manifest": "workspace:*",
    "@pramaan/release": "workspace:*",
    "@pramaan/verifier-core": "workspace:*",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0"
  }
}
